<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sufficit.Telephony.Panel</RootNamespace>
    <AssemblyName>Sufficit.Telephony.Panel</AssemblyName>
    <Version>0.13.2</Version>
    <RepositoryUrl>https://github.com/sufficit/sufficit-telephony-panel</RepositoryUrl>
    <Company>Sufficit</Company>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../sufficit-identity-client/authorization/Sufficit.Identity.Authorization.Client.csproj" />
    <EmbeddedResource Include="Localization/Portuguese.json" />
    <ProjectReference Include="../../sufficit-ami-events/streaming/Sufficit.Telephony.Streaming.csproj" />
    <Content Remove="appsettings.*.json" />
    <None Include="appsettings.*.json" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <ProjectReference Include="../../sufficit-blazor-ui/src/Sufficit.Blazor.UI.csproj" />
    <ProjectReference Include="../../sufficit-telephony-eventspanel-core/src/Sufficit.Telephony.EventsPanel.Core.csproj" />
    <Compile Include="../../sufficit-base/src/Telephony/Monitor/TelephonyMonitorActionRequest.cs" Link="Contracts/TelephonyMonitorActionRequest.cs" />
    <Compile Include="../../sufficit-base/src/Telephony/Monitor/TelephonyMonitorActionMode.cs" Link="Contracts/TelephonyMonitorActionMode.cs" />
  </ItemGroup>
</Project>
