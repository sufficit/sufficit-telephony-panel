@inject IConfiguration Configuration
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="@((Configuration["Panel:PathBase"] ?? "").TrimEnd('/') + "/")" />
    <link rel="icon" type="image/png" href="@Assets["panel-icon.png"]" />
    <link rel="stylesheet" href="@Assets["_content/Sufficit.Blazor.UI/sufficit-ui.css"]" />
    <link rel="stylesheet" href="@Assets["panel.css"]" />
    <link rel="stylesheet" href="@Assets["Sufficit.Telephony.Panel.styles.css"]" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
@* THESIS: observe three real PBXs without confusing stale data with zero load.
OWN-WORLD: user-pinned Sufficit SUI, orange identity, graphite operational surfaces.
STORY: select an authorized client, inspect calls and queues; infrastructure remains a separate view.
FIRST VIEWPORT: user-pinned operator mosaic, dense endpoint grid left, known trunks/channel rail right;
optional company filter, text/state legend and per-node detail, protected confirmation for supervision.
SETTINGS: SUI rule list and inline editor; ordered exact/prefix matches, draft preview and explicit shared save.
FORM: established SUI operational world, not a new visual-world selection.
FINISH: bounded motion, opt-in sound, desktop/mobile evidence and finish review. *@
    @if (HttpContextAccessor.HttpContext?.User is { } user && PanelImpersonation.IsImpersonating(user))
    {
        <div class="impersonation-banner" role="status">
            <span>Você está vendo o painel como <strong>@user.FindFirst("name")?.Value</strong>, com o acesso real dessa pessoa. Escuta e sussurro ficam desligados.</span>
            <form method="post" action="impersonate/exit"><AntiforgeryToken /><button type="submit">Sair e voltar para @(user.FindFirst(PanelImpersonation.ActorNameClaim)?.Value is { Length: > 0 } actor ? actor : "minha conta")</button></form>
        </div>
    }
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["panel.js"]"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
