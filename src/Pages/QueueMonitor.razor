@implements IAsyncDisposable
@using Sufficit.Telephony.Panel.Operations
@inject QueueBoardAccess Access
@inject PanelAccess PanelAuthorization
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment

<section class="queue-monitor" aria-labelledby="queue-title">
    <div class="monitor-head">
        <h1 id="queue-title">@Text["Queues and registration"]</h1>
        @if (ActiveFilters.Length > 0) { <span class="active-filters" aria-label="@Text["Filters active"]">@foreach (var label in ActiveFilters) { <span class="filter-chip">@label</span> }</span> }
        <SUIButton Class="@(ActiveFilters.Length > 0 ? "page-options-trigger is-marked" : "page-options-trigger")" VariantValue="SUIVariant.Outlined" SizeValue="SUISize.Small" StartIcon="@SUIIcons.Filter" popovertarget="queue-options">@Text["Filters and actions"]</SUIButton>
    </div>
    <div id="queue-options" class="board-options page-options" popover="auto" role="region" aria-label="@Text["Filters and actions"]">
        <div class="board-options-heading"><h2>@Text["Filters and actions"]</h2><SUIButton VariantValue="SUIVariant.Text" popovertarget="queue-options" popovertargetaction="hide">@Text["Close filters"]</SUIButton></div>
        <p class="muted">@Text["Observe queue stages and investigate extension registrations. Configuration stays in the management portal."]</p>
        <div class="queue-filters">
            @if (!Permissions.SingleContext.HasValue) {
            <SUISelect TValue="string" Label="@Text["Context"]" Value="Context" ValueChanged="ChangeContext">
                <SUISelectItem Value="@string.Empty">@Text["All authorized contexts"]</SUISelectItem>
                @foreach (var context in Samples.Select(s => s.ContextId.ToString("N")).Append(Context).Where(c => c.Length > 0).Distinct().Order())
                { <SUISelectItem Value="@context">@context</SUISelectItem> }
            </SUISelect>
            }
            <SUISelect TValue="string" Label="@Text["Server"]" Value="SelectedNode" ValueChanged="ChangeNode">
                <SUISelectItem Value="@("all")">@Text["All servers"]</SUISelectItem>
                @foreach (var node in Samples.Select(s => s.Node).Distinct().Order())
                { <SUISelectItem Value="@node">@node</SUISelectItem> }
            </SUISelect>
            <SUITextField TValue="string" Label="@Text["Search queue, extension, IP or device"]" Value="Search" ValueChanged="ChangeSearch" Immediate="true" />
        </div>
        <p class="muted filter-hint">@Text["Filters are saved in the URL. Server selection changes observation, not where queues can run."]</p>
        <div class="board-options-actions">
            <SUIButton OnClick="Refresh" Disabled="Busy" VariantValue="SUIVariant.Text" StartIcon="@SUIIcons.Refresh">@Text["Refresh"]</SUIButton>
            <SUIButton Href="@ManagementUrl" Target="_blank" VariantValue="SUIVariant.Text">@Text["Manage queues"]</SUIButton>
            @if (ActiveFilters.Length > 0) { <SUIButton OnClick="ClearFilters" VariantValue="SUIVariant.Text">@Text["Clear filters"]</SUIButton> }
        </div>
    </div>
    @if (Busy) { <SUIProgressLinear Indeterminate="true" aria-label="@Text["Loading diagnostics"]" /> }
    @if (Error is not null) { <SUIAlert ToneValue="SUITone.Danger">@Text[Error]</SUIAlert> }
    @if (!FilteredSamples.Any())
    {
        <QueueDistribution Context="@Context" Node="@SelectedNode" Search="@Search" QueueId="@QueueId" Preview="Preview" MembersChanged="SetFocusMembers" />
        @if (!Busy && Error is null && FocusQueue.Length == 0) { <p class="monitor-empty">@Text["No live queue controller source for these filters. Native PBX queues appear only in the distribution above."]</p> }
    }
    @if (FilteredSamples.Any() && NativeFocus)
    {
        <p class="focus-note">@Text["Native PBX queue: only the distribution below is available."] <SUIButton VariantValue="SUIVariant.Text" SizeValue="SUISize.Small" OnClick="ClearQueue">@Text["Show all queues"]</SUIButton></p>
        <QueueDistribution Context="@Context" Node="@SelectedNode" Search="@Search" QueueId="@QueueId" Preview="Preview" MembersChanged="SetFocusMembers" />
        <QueueSourceDetails Samples="FilteredSamples.ToArray()" />
    }
    else if (FilteredSamples.Any())
    {
        // One queue filter for the whole page: the tile/link ?queueid= or a controller queue chosen in the distribution.
        var overview = QueueMonitorOverview.Build(FilteredSamples, DateTimeOffset.UtcNow, Search, FocusQueue);
        var tiles = overview;
        var agents = FocusQueue.Length == 0 ? overview.Agents : overview.Agents.Where(a => FocusMembers.Contains(a.Extension)).ToArray();
        var stale = FilteredSamples.Any(s => !s.Available || s.Snapshot?.Fresh(DateTimeOffset.UtcNow) != true);
        var now = DateTimeOffset.UtcNow;
        long Live(Func<QueueBoardQueue, int> value) => overview.Queues.SelectMany(q => q.Observations.Where(o => o.Fresh)).Sum(o => (long)Math.Max(0, value(o.Queue)));
        var oldest = overview.Queues.Select(q => q.OldestEnteredAt).Where(a => a.HasValue).Min();
        var waitingAll = Live(q => Math.Max(0, q.Waiting - q.Offering));
        var longest = oldest is { } since ? Math.Max(0, (int)(now - since).TotalSeconds) : (int?)null;
        <div class="live-strip" aria-label="@Text["Now"]">
            <SUIStat Value="@waitingAll.ToString()" Label="@Text["Waiting now"]" Icon="bell" ColorValue="SUIColor.Warning"
                     Appearance="@(waitingAll > 0 ? SUIStatAppearance.Gradient : SUIStatAppearance.Soft)" />
            <SUIStat Value="@Live(q => q.Offering).ToString()" Label="@Text["Ringing agents"]" Icon="phone" ColorValue="SUIColor.Info" Appearance="SUIStatAppearance.Soft" />
            <SUIStat Value="@Live(q => q.Connected).ToString()" Label="@Text["In conversation"]" Icon="check-circle" ColorValue="SUIColor.Success" Appearance="SUIStatAppearance.Gradient" />
            <SUIStat Value="@(longest is { } secs ? secs + " s" : "—")" Label="@Text["Longest wait"]" Icon="clock"
                     ColorValue="@(longest > 60 ? SUIColor.Error : SUIColor.Secondary)" Appearance="@(longest > 60 ? SUIStatAppearance.Gradient : SUIStatAppearance.Plain)" />
            <SUIStat Value="@agents.Count(a => a.State(now) == "Available").ToString()" Unit="@("/" + agents.Length)" Label="@Text["Extensions available"]"
                     Icon="users" ColorValue="SUIColor.Primary" Appearance="SUIStatAppearance.Image" />
        </div>
        <section class="queue-queues monitor-card" aria-labelledby="queue-queues-title">
            <div class="monitor-card-head">
                <h2 id="queue-queues-title">@Text["Queues"] <span class="count">@tiles.Queues.Length</span></h2>
                <span class="info-dot" title="@Text["Activity across the selected sources. Cross-server call legs may be counted separately; capacity is not added across servers."]">i</span>
                @if (stale) { <span class="status-chip warn" title="@Text["Some sources have no current data. Counts marked ≥ include only current readings; retained details are historical."]">@Text["Partial data"]</span> }
            </div>
                <div class="queue-tiles" role="list">
                @foreach (var queue in tiles.Queues.Skip(QueuePage*30).Take(30))
                {
                    var selected = FocusQueue.Length > 0 && FocusQueue == queue.QueueId;
                    var fresh = queue.Observations.Where(o => o.Fresh).Select(o => o.Queue).ToArray();
                    var waiting = fresh.Sum(q => Math.Max(0, q.Waiting - q.Offering)); var ringing = fresh.Sum(q => q.Offering); var talking = fresh.Sum(q => q.Connected);
                    <button type="button" role="listitem" @key="(queue.ContextId, queue.QueueId)" class="queue-tile @(waiting > 0 ? "busy" : "") @(selected ? "selected" : "") @(fresh.Length == 0 ? "stale" : "")"
                            aria-pressed="@(selected ? "true" : "false")" title="@Provenance(queue)" @onclick="() => ToggleQueue(queue.QueueId)">
                        <span class="queue-tile-title">@queue.Title</span>
                        @if (fresh.Length > 0 && waiting + ringing + talking == 0 && queue.OldestEnteredAt is null)
                        { <span class="queue-tile-idle">@Text["No calls right now"]</span> }
                        else {
                        <span class="queue-tile-metrics">
                            <span data-metric="waiting" class="@(waiting == 0 ? "zero" : "")"><b>@queue.Count(q => Math.Max(0, q.Waiting - q.Offering))</b> @Text["Waiting"]</span>
                            <span data-metric="offering" class="@(ringing == 0 ? "zero" : "")"><b>@queue.Count(q => q.Offering)</b> @Text["Offering"]</span>
                            <span data-metric="connected" class="@(talking == 0 ? "zero" : "")"><b>@queue.Count(q => q.Connected)</b> @Text["In conversation"]</span>
                            @if (queue.OldestEnteredAt is { } oldestAt) { <span data-metric="oldest" class="warn"><b>@((queue.Partial ? "≥ " : "") + Math.Max(0, (int)(DateTimeOffset.UtcNow - oldestAt).TotalSeconds))s</b> @Text["Longest wait"]</span> }
                        </span>
                        }
                        <span class="queue-tile-capacity">@Text["Capacity"] @queue.CapacityText(value => Text[value])</span>
                    </button>
                }
                </div>
                @if (tiles.Queues.Length == 0) { <p class="monitor-empty">@Text["No queues in this reading match the search."]</p> }
                else if (FocusQueue.Length > 0) { <p class="queue-tiles-hint">@Text["Queue applied as a filter to the whole page."] <SUIButton VariantValue="SUIVariant.Text" SizeValue="SUISize.Small" OnClick="ClearQueue">@Text["Show all queues"]</SUIButton></p> }
                <details class="queue-visits"><summary>@Text["Observed queue calls"] (@overview.Visits.Length)</summary>
                    @foreach (var observation in overview.Visits.Skip(VisitPage*30).Take(30))
                    { <p>@observation.QueueTitle · @observation.Visit.Caller · @Text[observation.Fresh ? Phase(observation.Visit.Phase) : "No current data"] · @Time(observation.Visit.EnteredAt)<br /><code>@observation.Visit.ChannelName</code> · @observation.Source.Node
                        <SUIButton VariantValue="SUIVariant.Text" OnClick="() => SelectVisit(observation)">@Text["View timeline"]</SUIButton></p> }
                    <Pager Total="overview.Visits.Length" Page="VisitPage" PageChanged="value => VisitPage = value" />
                </details>
                <Pager Total="tiles.Queues.Length" Page="QueuePage" PageChanged="value => QueuePage = value" />
                @if(FilteredSamples.Any(s=>s.Snapshot?.VisitsTruncated==true))
                { <p class="muted">@Text["Live call details are a bounded sample. Queue totals include all observed visits; use call history to query other calls."]</p> }
        </section>
        var focusLive = FocusQueue.Length == 0 ? null : overview.Queues.FirstOrDefault(q => q.QueueId == FocusQueue);
        var focusFresh = focusLive?.Observations.Where(o => o.Fresh).Select(o => o.Queue).ToArray() ?? [];
        <QueueDistribution Context="@Context" Node="@SelectedNode" Search="@Search" QueueId="@QueueId" Preview="Preview" MembersChanged="SetFocusMembers"
            LiveWaiting="@(focusFresh.Length > 0 ? focusFresh.Sum(q => q.Waiting) : null)" LiveCapacity="@(focusFresh.Length > 0 ? focusFresh.Max(q => q.Capacity) : null)" />
        <QueueRegistrationTable Agents="agents" />
        <details class="queue-history monitor-card" open="@(SelectedVisit is not null)"><summary>@Text["Call diagnostics"]</summary><QueueCallDiagnostics Preview="Demo" Sources="FilteredSamples.ToArray()" SelectedVisit="SelectedVisit" /></details>
        <QueueSourceDetails Samples="FilteredSamples.ToArray()" />
    }
</section>

@code {
    [Parameter] public bool Preview { get; set; }
    private bool Demo => Preview && Environment.IsDevelopment();
    private QueueBoardSample[] Samples = [];
    private Sufficit.Identity.Authorization.CurrentAuthorization Permissions = Sufficit.Identity.Authorization.CurrentAuthorization.None;
    private string Context = "", Node = "all", Search = "", QueueId = "";
    private bool Busy, Disposed;
    private int QueuePage, VisitPage;
    private QueueVisitObservation? SelectedVisit;
    private void SelectVisit(QueueVisitObservation visit) { SelectedVisit=visit; }
    private string? Error;
    private readonly CancellationTokenSource Lifetime = new();
    private Task? Loop;
    private string SelectedNode => Node == "all" ? "all" : Samples.FirstOrDefault(s => s.MatchesNode(Node))?.Node ?? Node;
    private IEnumerable<QueueBoardSample> FilteredSamples => Samples.Where(s => (Context.Length == 0 || s.ContextId.ToString("N") == Context) && s.MatchesNode(Node));
    private string ManagementUrl => "https://blazor.sufficit.com.br/pages/telephony/queue" + (Context.Length > 0 ? "?contextid=" + Context : "");
    protected override async Task OnInitializedAsync()
    {
        ReadUrl(); Navigation.LocationChanged += LocationChanged;
        await Refresh(); Loop = Poll();
    }
    private void ReadUrl()
    {
        var query = BoardViewQuery.Parse(Navigation.Uri);
        Context = query.ContextId?.ToString("N") ?? ""; Node = query.Node; Search = query.Text;
        var raw = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        QueueId = raw.TryGetValue("queueid", out var value) && value.Count == 1 && Guid.TryParse(value[0], out var id) ? id.ToString("N") : "";
        DQueue = raw.TryGetValue("dqueue", out var dqueue) && dqueue.Count == 1 && dqueue[0] is { Length: > 2 and <= 260 } key && key.Contains('|') ? key : "";
        if (Guid.TryParse(Node, out var nodeId)) Node = nodeId.ToString("N");
    }
    private void LocationChanged(object? sender, LocationChangedEventArgs args) { ReadUrl(); _ = InvokeAsync(StateHasChanged); }
    private void WriteUrl() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        { ["contextid"] = Context.Length == 0 ? null : Context, ["company"] = null, ["node"] = Node == "all" ? null : Node, ["q"] = Search.Length == 0 ? null : Search, ["queueid"] = QueueId.Length == 0 ? null : QueueId, ["dqueue"] = DQueue.Length == 0 ? null : DQueue }), replace: true);
    private void ChangeContext(string value) { Context = value; QueueId = ""; QueuePage=VisitPage=0; SelectedVisit=null; WriteUrl(); }
    private void ChangeNode(string value) { Node = value; QueuePage=VisitPage=0; SelectedVisit=null; WriteUrl(); }
    private string[] ActiveFilters => new[]
    {
        Context.Length > 0 && !Permissions.SingleContext.HasValue ? Text["Context"] + ": " + Context[..Math.Min(8, Context.Length)] + "…" : null,
        Node != "all" ? Text["Server"] + ": " + SelectedNode : null,
        Search.Length > 0 ? "“" + Search + "”" : null,
        QueueId.Length > 0 ? Text["Queue"] + ": " + QueueId[..Math.Min(8, QueueId.Length)] + "…" : null,
        QueueId.Length == 0 && DQueueId.Length > 0 ? Text["Queue"] + ": " + (NativeFocus ? DQueueId : DQueueId[..8] + "…") : null,
    }.OfType<string>().ToArray();
    private void ClearFilters() { Context = Permissions.SingleContext?.ToString("N") ?? ""; Node = "all"; Search = ""; QueueId = ""; DQueue = ""; QueuePage = VisitPage = 0; SelectedVisit = null; WriteUrl(); }
    private void ToggleQueue(string queueId) { QueueId = FocusQueue == queueId ? "" : queueId; DQueue = ""; VisitPage = 0; SelectedVisit = null; WriteUrl(); }
    private void ClearQueue() { QueueId = ""; DQueue = ""; VisitPage = 0; SelectedVisit = null; WriteUrl(); }
    // Distribution choice (?dqueue=node|queue): controller queues use their id, native PBX queues their number.
    private string DQueue = "";
    private string DQueueId => DQueue.Split('|', 2) is [_, var id] ? id : "";
    private bool NativeFocus => QueueId.Length == 0 && DQueueId.Length > 0 && !Guid.TryParseExact(DQueueId, "N", out _);
    private string FocusQueue => QueueId.Length > 0 ? QueueId : !NativeFocus ? DQueueId : "";
    private string FocusLabel => DQueueId;
    private string[] FocusMembers = [];
    private void SetFocusMembers(string[] members) { FocusMembers = members; StateHasChanged(); }
    private string Provenance(QueueOverview queue) => Text["Context"] + ": " + queue.ContextId.ToString("N") + "\n" + string.Join("\n",
        queue.Observations.Select(o => o.Source.Node + " · " + Text[o.Fresh ? "Current collection" : "No current data"] + " · " + Time(o.Source.Snapshot?.ObservedAt)));
    private void ChangeSearch(string value) { Search = value ?? ""; QueuePage=VisitPage=0; WriteUrl(); }
    private string Time(DateTimeOffset? at) => at?.ToLocalTime().ToString("G", Text.Culture) ?? Text["Not observed"];
    private static string Phase(string value) => value switch { "greeting" => "Greeting", "waiting" => "Waiting", "announcing" => "Announcement", "offering" => "Offering", "connected" => "In conversation", _ => "Unknown" };
    private async Task Refresh()
    {
        if (Busy || Disposed) return;
        Busy = true; Error = null;
        try
        {
            if (Demo) { Samples = QueueMonitorFixture.Create(); }
            else
            {
                Permissions = await PanelAuthorization.PermissionsAsync(Lifetime.Token);
                var requested = Guid.TryParse(Context, out var id) ? id : (Guid?)null;
                var selected = Permissions.SelectContext(requested);
                if (selected.HasValue && Context != selected.Value.ToString("N"))
                { Context = selected.Value.ToString("N"); WriteUrl(); }
                Samples = await Access.Read(null, Lifetime.Token);
            }
        }
        catch (UnauthorizedAccessException) { Samples = []; Error = "Your access expired. Sign in again."; }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
        catch (Exception e) when (e is HttpRequestException or IOException or InvalidOperationException)
        { Samples = Samples.Select(s => s with { Available = false }).ToArray(); Error = "Monitoring is unavailable. Try refreshing."; }
        finally { Busy = false; if (!Disposed) StateHasChanged(); }
    }
    private async Task Poll()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try { while (await timer.WaitForNextTickAsync(Lifetime.Token)) await InvokeAsync(async () => { if (Error is null) await Refresh(); else StateHasChanged(); }); }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync() { Disposed = true; Navigation.LocationChanged -= LocationChanged; Lifetime.Cancel(); if (Loop is not null) await Loop; Lifetime.Dispose(); }
}
