@using Sufficit.Telephony.Panel.Operations
<span title="@(Changed ? Diagnostic : null)">@Source → @Target@if (Changed && Compact) { <span aria-label="@Text["Number normalized; original in call details"]"> *</span> }</span>
@if (Changed && !Compact)
{
    <small class="number-normalization">@Diagnostic</small>
}
@code {
    [Parameter] public string? Caller { get; set; }
    [Parameter] public string? Destination { get; set; }
    [Parameter] public bool Compact { get; set; }
    private string? NormalCaller => PhoneNumberPresentation.Normalize(Caller);
    private string? NormalDestination => PhoneNumberPresentation.Normalize(Destination);
    private bool Changed => NormalCaller != Caller || NormalDestination != Destination;
    private string Source => LiveProjection.Meaningful(Caller) ? NormalCaller! : Text["Source not reported"];
    private string Target => LiveProjection.Meaningful(Destination) ? NormalDestination! : Text["Destination not reported"];
    private string Diagnostic => Text.Format("Number normalized (550800 → 55800). Original source: {0}; original destination: {1}.", LiveFormat.Display(Caller), LiveFormat.Display(Destination));
}
