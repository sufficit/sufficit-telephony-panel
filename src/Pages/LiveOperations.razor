@implements IAsyncDisposable
@using Sufficit.Telephony.Panel.Operations
@using Sufficit.Telephony.EventsPanel
@using Sufficit.Telephony.Monitor
@using Sufficit.Identity.Authorization
@inject OperationsAccess Access
@inject AcdBoardAccess AcdAccess
@inject IWebHostEnvironment Environment
@inject IConfiguration Configuration
@inject BoardConfigurationAccess BoardAccess
@inject BoardInventoryAccess InventoryAccess
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (BoardPage)
{
    <section class="live-panel board-mode" aria-label="@Text["Operator board"]">
        <h1 class="sr-only">@Text["Operator board"]</h1>
        @BoardContent
    </section>
}
else
{
<section class="live-panel @(Tab is "board" or "settings" ? "board-mode" : "")" aria-labelledby="live-title">
    <div class="heading"><div><h1 id="live-title">@(BoardPage ? Text["Operator board"] : Text["Real-time telephony"])</h1><p class="muted">@Text["Exchange overview. Filter by company only when needed."]</p></div>
        <div class="tools">
        @if (!BoardPage) { <SUIButton Href="@BoardUrl" VariantValue="SUIVariant.Outlined">@Text["Open dedicated board"]</SUIButton> }
        <SUIButton OnClick="Reload" Disabled="Busy" VariantValue="SUIVariant.Outlined" StartIcon="@SUIIcons.Refresh">@Text["Reconnect and refresh"]</SUIButton>
        </div>
    </div>
    @if (Demo) { <SUIAlert ToneValue="SUITone.Warning">@Text["Local demonstration: fictional customers and events. No telephone action will be performed."]</SUIAlert> }
    @if (!Permissions.SingleContext.HasValue) { @CompanyFilter }
    @if (Busy) { <SUIProgressLinear Indeterminate="true" aria-label="@Text["Checking permissions and resources"]" /> }
    @if (Error is not null) { <SUIAlert ToneValue="SUITone.Danger">@Text.Observed(Error)</SUIAlert> }
    @if (SearchError is not null) { <SUIAlert ToneValue="SUITone.Warning">@Text.Observed(SearchError)</SUIAlert> }
    @if (AcdError is not null) { <SUIAlert ToneValue="SUITone.Warning">@AcdError</SUIAlert> }
    <div class="operations-scope">
        <div class="client-heading"><div><h2>@(Context.HasValue ? ClientName : Text["All authorized contexts"])</h2><span class="muted identifier">@(Context.HasValue ? Context.Value.ToString("N") : Permissions.Manager ? Text["No company filter · manager access"] : Text["Access restricted to your authorized contexts"])</span></div><span class="state-label @(Connected ? "good" : "warning")">@(Connected ? Text["Connected to the event stream"] : Text["Disconnected from events"])</span></div>
        @if (BoardPage) { <details class="observation-details"><summary>@Text["Observation limits and timestamps"]</summary>@ObservationNote</details> }
        else { @ObservationNote }
        @if (Overflow || Observation.Limited) { <SUIAlert ToneValue="SUITone.Warning">@Text["Observation limit reached. Some resources may be missing. Reduce this customer's configured resource set or reconnect to start a new window."]</SUIAlert> }
        @if (Tab != "settings")
        {
        @if (Tab != "board") { @BoardFilters }
        }
        <nav class="live-tabs @(BoardPage ? "board-navigation" : "")" aria-label="@Text["Resource type"]">
            @foreach (var tab in Tabs.Where(t => (Context.HasValue || t.Key != "trunks") && (Permissions.Manager || t.Key != "settings") && (!BoardPage || t.Key is "board" or "settings"))) { <button type="button" class="@(Tab == tab.Key ? "active" : "")" aria-pressed="@(Tab == tab.Key)" @onclick="() => SetTab(tab.Key)">@(tab.Key == "extensions" && !Context.HasValue ? Text["Extensions and endpoints"] : tab.Label) <span>@Count(tab.Key)</span></button> }
        </nav>
        @if (BoardError is not null) { <SUIAlert ToneValue="SUITone.Warning">@Text.Observed(BoardError)</SUIAlert> }
        @if (SettingsOpened && Permissions.Manager)
        {
            <div hidden="@(Tab != "settings")"><BoardSettings Configuration="BoardConfiguration" Source="RawBoardTiles" Demo="Demo" Saved="SetBoardConfiguration" /></div>
        }
        @if (Tab == "board" && Permissions.Manager)
        {
            <details class="board-retention" open="@(!BoardPage)"><summary>@Text["Remembered resources and cleanup"]</summary>
            <div class="settings-toolbar">
                <SUICheckbox Value="BoardConfiguration.RetainSeenResources" ValueChanged="SetRetention" Disabled="@(Busy || InventoryBusy || Error is not null)" Label="@Text["Keep previously seen resources"]" />
                <SUIButton OnClick="() => ConfirmClearInventory = true" Disabled="@(Busy || InventoryBusy || Error is not null)" VariantValue="SUIVariant.Text">@Text["Clear remembered resources"]</SUIButton>
                @if (Demo) { <SUIButton OnClick="SimulateMissingEvents" VariantValue="SUIVariant.Text">@Text["Simulate missing events"]</SUIButton> }
            </div>
            <p class="muted section-hint">@Text["Keeping previously seen resources is enabled by default and shared between managers. It retains existence, not old state. Disabling only hides resources without current observations; rules and filters still apply."]</p>
            @if (InventoryError is not null) { <SUIAlert ToneValue="SUITone.Warning">@Text.Observed(InventoryError)</SUIAlert> }
            @if (InventoryMessage is not null) { <p role="status">@Text.Observed(InventoryMessage)</p> }
            @if (ConfirmClearInventory)
            {
                <div class="settings-confirm" role="alert">
                    <p>@Text.Format("Clear remembered resources for {0} for all managers? Current resources remain; new events may record them again. Extensions, queues, calls and rules are unchanged.", Context.HasValue ? Text["this company"] : Text["entire exchange"])</p>
                    <SUIButton OnClick="ClearInventory" Disabled="InventoryBusy">@Text["Confirm cleanup"]</SUIButton>
                    <SUIButton OnClick="() => ConfirmClearInventory = false" Disabled="InventoryBusy" VariantValue="SUIVariant.Text">@Text["Cancel cleanup"]</SUIButton>
                </div>
            }
            </details>
            @if (OnlyObservedChannels) { <p class="muted section-hint" role="status">@Text["Filter enabled: only resources with observed channels. No channels does not prove a resource is idle."]</p> }
            @BoardContent
        }
        else if (Tab == "settings") { }
        else if (Tab == "events")
        {
            <p class="muted">@Text["Latest observed event per resource. This diagnostic view is bounded, not a complete AMI event log."]</p>
            <SUITable T="ObservedResource" Items="VisibleEvents.Skip(Page * PageSize).Take(PageSize)" Dense="true" StackOnMobile="true" ColumnCount="5">
                <HeaderContent><SUITh>@Text["Server"]</SUITh><SUITh>@Text["Resource"]</SUITh><SUITh>@Text["Observed state"]</SUITh><SUITh>@Text["Last event"]</SUITh><SUITh>@Text["Details"]</SUITh></HeaderContent>
                <RowTemplate><SUITd DataLabel="@Text["Server"]">@context.Node</SUITd><SUITd DataLabel="@Text["Resource"]">@context.Key</SUITd><SUITd DataLabel="@Text["Observed state"]">@ResourceState(context)</SUITd><SUITd DataLabel="@Text["Last event"]">@Timestamp(context.Updated)<br />@context.Peer?.LastEventType</SUITd>
                    <SUITd DataLabel="@Text["Details"]"><details><summary>@Text["View details"]</summary>@foreach (var pair in context.Details) { <p>@pair.Key: @pair.Value</p> }</details></SUITd></RowTemplate>
                <NoRecordsContent>@Text["No observed events match these filters."]</NoRecordsContent>
            </SUITable>
        }
        else if (Tab == "calls")
        {
            var groups = VisibleGroups;
            <p class="muted section-hint">@Text.Format("{0} correlated calls · {1} observed channels · {2} uncorrelated. Calls group channels with the same Linkedid on one server; there is no cross-server deduplication.", groups.Count(g => g.Correlated), groups.Sum(g => g.Channels.Length), groups.Count(g => !g.Correlated))</p>
            <p class="muted section-hint">@Text["Expand to inspect channels. State belongs to each channel, not the entire call: “Inactive in event” does not prove the call ended. Elapsed time starts at the first available observation."]</p>
            @if (groups.Length == 0) { <div class="operation-empty">@Text["No groups observed with these filters. Wait for new events or check the connection."]</div> }
            else
            {
                <div class="resource-list">
                @foreach (var group in groups.Skip(Page * PageSize).Take(PageSize))
                {
                    <details class="resource call-group" @key="(group.Node, group.LinkedId, group.Correlated ? string.Empty : group.Channels[0].Id)">
                        <summary><span class="resource-title">@(group.Correlated ? Text["Correlated call"] : Text["Uncorrelated channel"])<small>@(group.Correlated ? $"Linkedid: {group.LinkedId}" : group.Channels[0].Key)</small></span><span class="resource-status">@group.Node · @Text.Format("{0} channels", group.Channels.Length)<small>@Text.Format("Observed for {0} · last event {1}", Duration(group.FirstSeen), group.Updated.ToLocalTime().ToString("T", Text.Culture))</small></span><span class="resource-expand">@Text["View channels"]</span></summary>
                        <div class="resource-body">
                            @if (!group.Correlated) { <p>@Text["Linkedid not received. This channel is excluded from correlated call counts."]</p> }
                            @if (group.Channels.Length > 100) { <p>@Text.Format("Showing 100 of {0} channels in this group. Use Channels to view all.", group.Channels.Length)</p> }
                            @RenderChannels(group.Channels.Take(100).ToArray())
                        </div>
                    </details>
                }
                </div>
            }
        }
        else if (Tab == "channels")
        {
            <p class="muted section-hint">@Text["Each row is a channel, not a separate call. SIP/PJSIP channels and Local legs may belong to the same call."]</p>
            @if (VisibleChannels.Length == 0) { <div class="operation-empty">@Text["No channels observed with these filters."]</div> }
            else { @RenderChannels(VisibleChannels.Skip(Page * PageSize).Take(PageSize).ToArray()) }
        }
        else
        {
            @if (!Context.HasValue) { <p class="muted section-hint">@Text["Resources found in the central stream, including those not configured as portal cards. Extension and trunk endpoints appear together because events do not identify their classification. Absence from this list does not prove an extension is offline."]</p> }
            @if (VisibleCards.Length == 0) { <div class="operation-empty">@Text["No authorized resource matches the filters. Extension, trunk and queue configurations are maintained in the portal."]</div> }
            else
            {
                <div class="resource-list">
                @foreach (var card in VisibleCards.Skip(Page * PageSize).Take(PageSize))
                {
                    var related = Related(card);
                    var callCount = related.Count(x => x.Kind == "call");
                    <details class="resource" @key="CardKey(card)">
                        <summary><span class="resource-title">@card.Label <small>@(!Context.HasValue && card.Kind == EventsPanelCardKind.PEER ? Text["Endpoint · type not reported by event"] : KindLabel(card.Kind))</small></span><span class="resource-status">@ResourceSummary(related)</span><span class="resource-expand">@Text["Details"]</span></summary>
                        <div class="resource-body">
                            <p class="muted">@Text.Format("Identifiers: {0}. Resources shared across servers appear separately per node.", string.Join(" · ", card.Channels))</p>
                            @if (related.Length == 0) { <p>@Text["Waiting for events since connection. This resource may be in use without sending an event during this window."]</p> }
                            else
                            {
                                <p class="scroll-hint">@Text["Scroll to inspect registration, reachability, usage and timestamps. With a keyboard, focus the table and use arrow keys."]</p>
                                <div class="live-table-wrap" role="region" tabindex="0" aria-label="@Text.Format("Details for {0}, horizontally scrollable table", card.Label)"><table class="live-table"><thead><tr><th>@Text["Resource"]</th><th>@Text["Observed state"]</th><th>@Text["SIP registration"]</th><th>@Text["Last observed registration"]</th><th>@Text["Server"]</th><th>@Text["Last event"]</th></tr></thead><tbody>
                                @foreach (var row in related.Take(100))
                                {
                                    <tr @key="row.Id"><td>@row.Key<small>@(row.Kind == "waiting" ? Text.Format("Waiting since {0}", row.FirstSeen.ToLocalTime().ToString("T", Text.Culture)) : Display(row.Caller))</small></td><td>@ResourceState(row)
                                        @if (row.Peer is { } peer) { <small>@Text.Observed(peer.DeviceLabel)</small><small>@Text.Format("Reachability observed: {0}", Timestamp(peer.ReachabilityObservedAt))</small>@if (peer.RoundTripMilliseconds is { } rtt) { <small>@Text.Format("Response: {0} ms", rtt.ToString("0.###", Text.Culture))</small> }@if (peer.LastReachabilityIsContact) { <small>@Text["Last observed contact; does not aggregate all devices."]</small> } }
                                        @if (row.Details.Count > 0) { <small>@string.Join(" · ", row.Details.Where(p => p.Key is not ("uniqueid" or "linkedid" or "queue")).Select(p => $"{DetailLabel(p.Key)}: {DetailValue(p.Value)}"))</small> }
                                    </td><td>@Text.Observed(row.Peer?.RegistrationLabel ?? Text["Not reported"])<small>@Timestamp(row.Peer?.RegistrationObservedAt)</small></td><td>@Timestamp(row.Peer?.LastRegisteredObservedAt)</td><td>@row.Node</td><td>@Timestamp(row.Updated)<small>@row.Peer?.LastEventType</small></td></tr>
                                }
                                </tbody></table></div>
                                @if (related.Length > 100) { <p>@Text["Showing the first 100 resource events. Refine by server."]</p> }
                            }
                        </div>
                    </details>
                }
                </div>
            }
        }
        @if (Tab is "calls" or "channels") { <p class="muted section-hint">@(Supervisor is { } supervisor ? Text.Format("Your supervision extension: {0}.", supervisor.Title) : Text["Set your preferred extension in the portal to enable supervision."]) @Text["Select the correct channel to listen or whisper. Actions require a recent event and verified company association."]</p> }
        @if (Tab is not ("board" or "settings")) { <div class="live-pagination"><span>@Text.Format("{0} results with current filters · page {1} of {2}", TotalVisible, Page + 1, Pages)</span><div><SUIButton VariantValue="SUIVariant.Text" Disabled="@(Page == 0)" OnClick="Previous">@Text["Previous"]</SUIButton><SUIButton VariantValue="SUIVariant.Text" Disabled="@(Page + 1 >= Pages)" OnClick="Next">@Text["Next"]</SUIButton></div></div> }
        @ActionConfirmation
        <details class="live-help"><summary>@Text["How to read this panel"]</summary><p>@Text["The overview shows the manager-authorized stream; company filtering uses resources authorized by the portal. Reconnecting discards old states. Current observation is limited to 5,000 resources and two hours without updates, not a full inventory. Keep previously seen resources retains the existence of extensions, trunks and queues separately, without automatic expiration or old channels. The saved last observation is approximate. Clearing remembered resources removes that history from the selected view; new events can record them again."]</p><p>@Text["SIP registration, reachability and device usage are independent. An extension may be registered but not respond. A static contact may respond without registering. Qualify does not prove the phone's WebSocket/TCP connection. Registration time here is when the panel received a registration event, not the PBX's historical timestamp. Events before connection are unavailable."]</p><p>@Text["Call queues distribute calls among agents. ACD stands for automatic call distribution. This monitor does not create queues or replace their management screen."]</p></details>
    </div>
</section>
}

@code {
    private RenderFragment ActionConfirmation => @<div>
        @if (Pending is { } target)
        {
            <section class="monitor-confirm" role="region" aria-labelledby="confirm-title" tabindex="-1" @ref="Confirmation">
                <h2 id="confirm-title">@(Mode == TelephonyMonitorActionMode.Listen ? Text["Confirm listening"] : Text["Confirm whispering"])</h2>
                <p>@Text["Customer"] <strong>@(Context.HasValue ? ClientName : target.Account)</strong> · @target.Key · @target.Node</p>
                <p>@(Mode == TelephonyMonitorActionMode.Listen ? Text["You will hear the call without speaking to its participants."] : Text["You will be able to speak to the agent during monitoring."]) @Text.Format("Your extension {0} will be called. Answer it to begin. Use only with operational authorization.", Supervisor?.Title)</p>
                <div class="tools"><SUIButton OnClick="Confirm" Disabled="ActionBusy" VariantValue="SUIVariant.Filled">@(ActionBusy ? Text["Sending…"] : Text["Confirm and call my extension"])</SUIButton><SUIButton OnClick="CancelAction" Disabled="ActionBusy" VariantValue="SUIVariant.Text">@Text["Cancel"]</SUIButton></div>
            </section>
        }
        @if (ActionMessage is not null) { <SUIAlert ToneValue="SUITone.Info">@Text.Observed(ActionMessage)</SUIAlert> }
    </div>;
    [Parameter] public bool Dark { get; set; }
    [Parameter] public EventCallback ThemeChanged { get; set; }
    private bool FiltersActive => Context.HasValue || Filter.Length > 0 || Node != "all" || StatusFilter != "all" || OnlyObservedChannels || TextKinds.Length != 3;
    private bool ObservationWarning => !Connected || Error is not null || AcdError is not null || BoardError is not null || InventoryError is not null || Overflow || Observation.Limited;
    private string NormalPanelUrl(string? tab = null) => Navigation.GetUriWithQueryParameters(Navigation.BaseUri, new Dictionary<string, object?>(CurrentQuery.Parameters()) { ["preview"] = Demo ? "true" : null, ["tab"] = tab });
    private RenderFragment FilterTrigger => @<SUIButton Class="@(FiltersActive || ObservationWarning ? "board-filter-trigger is-marked" : "board-filter-trigger")" VariantValue="SUIVariant.Text" SizeValue="SUISize.Small" StartIcon="@SUIIcons.Filter" popovertarget="board-options" aria-label="@Text["Board filters and options"]" title="@Text["Board filters and options"]">
        @if (ObservationWarning) { <span aria-label="@Text["Check observation status"]">!</span> }
        else if (FiltersActive) { <span class="filter-mark" aria-label="@Text["Filters active"]"></span> }
    </SUIButton>;
    private RenderFragment DedicatedOptions => @<div id="board-options" class="board-options" popover="auto" role="region" aria-label="@Text["Board filters and options"]">
        <div class="board-options-heading"><h2>@Text["Board filters and options"]</h2><SUIButton VariantValue="SUIVariant.Text" popovertarget="board-options" popovertargetaction="hide">@Text["Close filters"]</SUIButton></div>
        @BoardFilters
        @if (!Permissions.SingleContext.HasValue) { @CompanyFilter }
        <div class="board-options-actions"><LanguagePicker /><SUIButton OnClick="() => ThemeChanged.InvokeAsync()" VariantValue="SUIVariant.Text">@(Dark ? Text["Light theme"] : Text["Dark theme"])</SUIButton><SUIButton OnClick="ToggleFullscreen" VariantValue="SUIVariant.Text"><span class="fullscreen-enter">@Text["Full screen"]</span><span class="fullscreen-exit">@Text["Exit full screen"]</span></SUIButton></div>
        <div class="board-options-actions"><SUIButton OnClick="Reload" Disabled="Busy" VariantValue="SUIVariant.Text">@Text["Reconnect and refresh"]</SUIButton><SUIButton Href="@NormalPanelUrl()" target="_blank" rel="noopener" title="@Text["Opens in a new tab"]" VariantValue="SUIVariant.Text">@Text["Back to panel"]</SUIButton>@if (Permissions.Manager) { <SUIButton Href="@NormalPanelUrl("settings")" target="_blank" rel="noopener" title="@Text["Opens in a new tab"]" VariantValue="SUIVariant.Text">@Text["Configure board"]</SUIButton> }</div>
        <p class="@(ObservationWarning ? "warning" : "good")" role="status">@(Connected ? Text["Connected to the event stream"] : Text["Disconnected from events"])</p>
        @foreach (var message in new[] { Error, SearchError, AcdError, BoardError, InventoryError }.Where(m => m is not null)) { <SUIAlert ToneValue="SUITone.Warning">@Text.Observed(message!)</SUIAlert> }
        @if (FullscreenError) { <SUIAlert ToneValue="SUITone.Warning">@Text["Full screen is not available in this browser. The dedicated board remains available."]</SUIAlert> }
        @if (Overflow || Observation.Limited) { <p class="warning">@Text["Observation limit reached. Some resources may be missing. Reduce this customer's configured resource set or reconnect to start a new window."]</p> }
        @if (Demo) { <p>@Text["Local demonstration: fictional customers and events. No telephone action will be performed."]</p> }
    </div>;
    [CascadingParameter(Name = "PanelLanguage")] public string Language { get; set; } = "en";
    private RenderFragment CompanyFilter => @<details class="company-filter" open="@(!BoardPage)"><summary>@Text["Context"]: @(Context.HasValue ? ClientName : Text["All authorized contexts"])</summary>
    @if (!Permissions.GlobalPanel)
    {
        <SUISelect T="string" Label="@Text["Context"]" Value="@(Context?.ToString("D") ?? "")" ValueChanged="SelectAuthorizedContext" Disabled="Busy">
            <SUISelectItem Value="@string.Empty">@Text["All authorized contexts"]</SUISelectItem>
            @foreach (var id in Permissions.PanelContexts.Order())
            { <SUISelectItem Value="@id.ToString("D")">@id.ToString("D")</SUISelectItem> }
        </SUISelect>
    }
    else
    {
    <div class="client-picker">
        <SUITextField T="string" Label="@Text["Company (optional)"]" @bind-Value="SearchText" Immediate="true" Placeholder="@Text["Company name or identifier"]" MaxLength="100" Disabled="Busy" />
        <SUIButton OnClick="Search" Disabled="@(Busy || SearchText.Trim().Length < 2)" VariantValue="SUIVariant.Outlined">@Text["Find company"]</SUIButton>
        @if (Context.HasValue) { <SUIButton OnClick="ClearCompany" Disabled="@(Busy || ActionBusy)" VariantValue="SUIVariant.Text">@Text["Clear company · view exchange"]</SUIButton> }
    </div>
    @if (Searched)
    {
        <div class="client-results" aria-label="@Text["Matching customers"]">
            @if (Clients.Length == 0) { <p>@Text["No customers found for this user. Try the full customer identifier."]</p> }
            @foreach (var client in Clients) { <SUIButton OnClick="() => SelectClient(client.Id, client.Title)" Disabled="Busy" VariantValue="SUIVariant.Outlined">@client.Title</SUIButton> }
        </div>
    }
    }
    </details>;
    private Task SelectAuthorizedContext(string value) => Guid.TryParse(value, out var id)
        ? SelectClient(id, id.ToString("D")) : ClearCompany();
    private RenderFragment BoardContent => @<div class="board-focus" id="board-focus">
            @if (!BoardPage)
            {
            @if (Demo) { <span class="board-demo-label">@Text["Local demo"]</span> }
            <div class="board-focus-toolbar"><strong>@Text["Operator board"]</strong><span class="muted">@(Context.HasValue ? ClientName : Text["Entire exchange"])</span><span class="board-focus-spacer"></span><LanguagePicker /><SUIButton OnClick="ToggleFullscreen" VariantValue="SUIVariant.Text"><span class="fullscreen-enter">@Text["Full screen"]</span><span class="fullscreen-exit">@Text["Exit full screen"]</span></SUIButton></div>
            @if (FullscreenError) { <SUIAlert ToneValue="SUITone.Warning">@Text["Full screen is not available in this browser. The dedicated board remains available."]</SUIAlert> }
            @BoardFilters
            }
            @if (BoardPage) { @DedicatedOptions }
            <OperatorBoard Compact="BoardPage" HeaderTools="@(BoardPage ? FilterTrigger : null)" Tiles="VisibleTiles" Central="@(!Context.HasValue && !Demo)" Selected="SelectedTileId" Select="SelectTile" Supervise="PrepareBoardSupervision" CanSupervise="CanSuperviseTile" Page="Page" PageChanged="SetBoardPage" />
            @if (BoardAction is { } action)
            {
                <BoardSupervisionDialog @key="action" Request="action" Context="Context" Connected="Connected" Demo="Demo" DemoEndpointResolution="DemoEndpointResolution" Supervisor="Supervisor" Closed="() => BoardAction = null" />
            }
            @if (SelectedTile is { } tile)
            {
                @if (BoardPage)
                {
                    <BoardResourceDialog Title="@($"{tile.Title} · {tile.Node}")" Closed="CloseTile">
                        @ResourceDetails(tile)
                        @ActionConfirmation
                    </BoardResourceDialog>
                }
                else
                {
                <section class="board-inspector" tabindex="-1" @ref="TileInspector" aria-labelledby="tile-heading">
                    <div class="heading"><h3 id="tile-heading">@tile.Title · @tile.Node</h3><SUIButton VariantValue="SUIVariant.Text" OnClick="CloseTile">@Text["Close details"]</SUIButton></div>
                    @ResourceDetails(tile)
                </section>
                }
            }
            </div>;
    private RenderFragment ResourceDetails(OperatorTile tile) => @<div class="resource-details">
                    <p>@Text.Observed(tile.Status.Label) · @(tile.Remembered ? Text["Saved last observation (approximate)"] : Text["Last observation"]): @Timestamp(tile.Updated)</p>
                    @if (tile.Acd is { } acd)
                    {
                        <p>ACD · @Text["Context"]: @acd.Account · @Text["Call queue"]: @acd.Details["queueid"]</p>
                        <p>@Text["ACD data comes from the queue controller, not native AMI queue events."]</p>
                        @if (acd.State != "current") { <p>@Text["ACD state unavailable. Previous activity is not shown as live. Refresh to retry."]</p> }
                        else if (acd.Details["correlation"] == "unavailable") { <p>@Text["This controller reports counts only; channel correlation requires its monitoring update."]</p> }
                    }
                    else
                    {
                    <p>@Text.Observed(tile.Peer?.RegistrationLabel ?? Text["Registration not reported"]) · @Text.Observed(tile.Peer?.ReachabilityLabel ?? Text["Reachability not reported"]) · @Text.Observed(tile.Peer?.DeviceLabel ?? Text["Device usage not reported"])</p>
                    <p>@Text.Format("Last observed registration: {0}. Unknown states do not mean the extension is idle.", Timestamp(tile.Peer?.LastRegisteredObservedAt))</p>
                    }
                    @foreach (var flow in tile.Flows)
                    {
                        <p>@Display(flow.Caller) → @Display(flow.Destination) · @Text[PhaseLabel(flow.Phase)]</p>
                    }
                    @if (tile.DetailChannels.Length > 0) { @RenderChannels(tile.DetailChannels.Take(100).ToArray()) }
                    else { <p>@Text["No observed channels for this resource."]</p> }
                    @if (tile.DetailChannels.Length > 100) { <p>@Text["First 100 channels. Refine the Channels tab to view the others."]</p> }
            </div>;
    private RenderFragment BoardFilters => @<header class="board-filter-header">
        <div class="live-filters">
            <SUITextField T="string" Label="@Text["Filter resources"]" Value="@Filter" ValueChanged="SetFilter" Immediate="true" MaxLength="100" Clearable="true" Placeholder="@Text["Extension, name, number or channel"]" />
            <SUISelect T="string" Label="@Text["Observed server"]" Value="@Node" ValueChanged="SetNode"><SUISelectItem Value="@("all")">@Text["All servers"]</SUISelectItem>@foreach (var node in Rows.Select(x => x.Node).Concat(BoardTiles.Select(t => t.Node)).Distinct().Order()) { <SUISelectItem Value="@node">@node</SUISelectItem> }</SUISelect>
