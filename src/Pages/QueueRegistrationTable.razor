@using Sufficit.Telephony.Panel.Operations
<section class="queue-diagnostics" aria-label="@Text["Extension diagnostics"]">
    <h3>@Text["Extension presence and registrations"]</h3>
    <p class="muted">@Text["Registration and queue membership are independent. History contains observed changes, not exact SIP message times."]</p>
    <SUITable T="QueueAgentOverview" Items="Agents.Skip(Page*30).Take(30)" Dense="true" StackOnMobile="true" ColumnCount="8">
        <HeaderContent><SUITh>@Text["Extension"]</SUITh><SUITh>@Text["Observed state"]</SUITh><SUITh>@Text["Contact IP"]</SUITh><SUITh>@Text["Declared device"]</SUITh><SUITh>@Text["Registration"]</SUITh><SUITh>@Text["Reachability"]</SUITh><SUITh>@Text["Usage"]</SUITh><SUITh>@Text["Diagnostics"]</SUITh></HeaderContent>
        <RowTemplate Context="agent">
            <SUITd DataLabel="@Text["Extension"]"><code>@agent.Extension</code></SUITd>
            <SUITd DataLabel="@Text["Observed state"]">@Text[agent.State(DateTimeOffset.UtcNow)]<SUIText Typo="SUITypo.caption">@Time(agent.ObservedAt) · @Math.Max(0,(int)(DateTimeOffset.UtcNow-agent.ObservedAt).TotalSeconds) s</SUIText>
                @if (agent.Observations.Any(o => !o.Fresh || !o.Agent.Fresh(DateTimeOffset.UtcNow))) { <SUIText Typo="SUITypo.caption">@Text["Includes historical readings"]</SUIText> }
            </SUITd>
            <SUITd DataLabel="@Text["Contact IP"]">@Contacts(agent.Contacts, c => c.IpAddress)</SUITd>
            <SUITd DataLabel="@Text["Declared device"]">@Contacts(agent.Contacts, c => c.UserAgent)</SUITd>
            <SUITd DataLabel="@Text["Registration"]">@Evidence(agent,a=>a.Registered)</SUITd>
            <SUITd DataLabel="@Text["Reachability"]">@Evidence(agent,a=>a.Reachable)</SUITd>
            <SUITd DataLabel="@Text["Usage"]">@Evidence(agent,a=>a.Busy)</SUITd>
            <SUITd DataLabel="@Text["Diagnostics"]" Class="registration-details-cell">
                <details @key="agent.Key" open="@Expanded.Contains(agent.Key)">
                    <summary @onclick="() => Toggle(agent.Key)" @onclick:preventDefault>@Text["History and contacts"] · @agent.Observations.Sum(o => o.Agent.RegistrationHistory?.Length ?? 0)</summary>
                    @if(Expanded.Contains(agent.Key))
                    {
                    <p class="muted">@Text["Up to 20 observed changes per source over 7 days. User-Agent is device-declared; Via IP can differ from contact IP."]</p>
                    <p class="muted">@Text["Context"]: @agent.ContextId.ToString("N")</p>
                    @foreach (var observation in agent.Observations)
                    { <p><strong>@observation.Source.Node</strong> · @Text[observation.Agent.State(DateTimeOffset.UtcNow, observation.Fresh)] · @Time(observation.Agent.ObservedAt)<br />@Text["History collected since"]: @Time(observation.Agent.HistorySince)</p>
                        @foreach (var contact in observation.Agent.Contacts ?? [])
                        { <p>@Text["Contact IP"]: @(contact.IpAddress ?? "—") · Via: @(contact.ViaAddress ?? "—")<br />@contact.Endpoint · @contact.UserAgent<br />@Text["Expires"]: @Time(contact.ExpiresAt)</p> }
                    }
                    <ol>@foreach (var item in agent.Observations.SelectMany(o => (o.Agent.RegistrationHistory ?? []).Select(h => (o.Source.Node, Entry: h))).OrderByDescending(h => h.Entry.ObservedAt))
                    { <li>@Time(item.Entry.ObservedAt) · @Text[Event(item.Entry.Event)] · @item.Node<br />@Contacts(item.Entry.Contacts, c => c.IpAddress) · @Contacts(item.Entry.Contacts, c => c.UserAgent)</li> }</ol>
                    @if (agent.Observations.Any(o => o.Agent.RegistrationHistory is not { Length: > 0 }))
                    { <p>@Text["History is not available on every source. Earlier registrations were not reconstructed."]</p> }
                    }
                </details>
            </SUITd>
        </RowTemplate>
        <NoRecordsContent>@Text["No extension observations match the filters."]</NoRecordsContent>
    </SUITable>
    <p class="muted">@Text["Declared mobile applications do not prove battery state or wake-up support. Offline registration is an observation, not a saved expected-offline preference."]</p>
    <SUIButton OnClick="() => Page=Math.Max(0,Page-1)" Disabled="@(Page==0)">@Text["Previous page"]</SUIButton>
    <SUIButton OnClick="() => Page++" Disabled="@((Page+1)*30>=Agents.Length)">@Text["Next page"]</SUIButton>
</section>
@code {
    [Parameter] public QueueAgentOverview[] Agents { get; set; } = [];
    private int Page;
    protected override void OnParametersSet() { Page=Math.Min(Page,Math.Max(0,(Agents.Length-1)/30)); Expanded.IntersectWith(Agents.Skip(Page*30).Take(30).Select(a=>a.Key)); }
    private string Evidence(QueueAgentOverview agent,Func<QueueAgentPresence,bool?> select)
    {
        var values=agent.Observations.Where(o=>o.Fresh && o.Agent.Fresh(DateTimeOffset.UtcNow)).Select(o=>select(o.Agent)).Distinct().ToArray();
        return Text[values.Length==0 ? "No current data" : values.Length>1 ? "Different readings" : values[0] is true ? "Yes" : values[0] is false ? "No" : "Unknown"];
    }
    private readonly HashSet<string> Expanded = [];
    private void Toggle(string extension) { if (!Expanded.Add(extension)) Expanded.Remove(extension); }
    private string Time(DateTimeOffset? at) => at?.ToLocalTime().ToString("G", Text.Culture) ?? Text["Not observed"];
    private string Contacts(QueueContact[]? contacts, Func<QueueContact, string?> select) => string.Join(" · ", (contacts ?? []).Select(select).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct()) is { Length: > 0 } value ? value : Text["Not reported"];
    private static string Event(string value) => value switch { "registered" => "Registration observed", "renewed" => "Renewal observed", "unregistered" => "Unregistered", "changed" => "Contact or reachability changed", "unknown" => "Unknown", _ => "First observation" };
}
