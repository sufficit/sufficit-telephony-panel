@implements IAsyncDisposable
@using Sufficit.Telephony.Panel.Operations
@using Sufficit.Telephony.Streaming
@inject QueueDistributionAccess Access
@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation

<section class="distribution monitor-card" aria-labelledby="distribution-title">
    <div class="distribution-head monitor-card-head">
        <h2 id="distribution-title">@Text["Queue distribution"]</h2>
        <span class="info-dot" title="@(Text["Which extensions receive each queue's calls: how often they rang, answered, let it ring or were unavailable."] + (Reply is null ? "" : " " + Text.Format("Counted in memory since {0}, without a database. Restarting the collector starts the count again.", Started)))">i</span>
        <span class="distribution-summary">@(Queues.FirstOrDefault(q => q.Key == ActiveKey) is { } current ? QueueLabel(current) : Text["Busiest queues"]) · @WindowLabel(Window)</span>
        @if (Detail is not null && (SelectedKey.Length > 0 || QueueId.Length > 0))
        { <SUIButton VariantValue="SUIVariant.Text" SizeValue="SUISize.Small" OnClick="() => SelectQueue(string.Empty)">← @Text["All queues"]</SUIButton> }
        <SUIButton Class="distribution-options-trigger" VariantValue="SUIVariant.Text" SizeValue="SUISize.Small" StartIcon="@SUIIcons.Filter" popovertarget="distribution-options">@Text["Queue and period"]</SUIButton>
    </div>
    <div id="distribution-options" class="board-options page-options" popover="auto" role="region" aria-label="@Text["Queue and period"]">
        <div class="board-options-heading"><h2>@Text["Queue and period"]</h2><SUIButton VariantValue="SUIVariant.Text" popovertarget="distribution-options" popovertargetaction="hide">@Text["Close filters"]</SUIButton></div>
        <p class="muted">@Text["Which extensions receive each queue's calls: how often they rang, answered, let it ring or were unavailable."]</p>
        <div class="distribution-toolbar">
            @if (Queues.Length > 1)
            {
                <SUISelect TValue="string" Label="@Text["Queue"]" Value="SelectedKey" ValueChanged="SelectQueue">
                    <SUISelectItem Value="@string.Empty">@Text["Busiest queues"]</SUISelectItem>
                    @foreach (var queue in Queues)
                    { <SUISelectItem Value="@queue.Key">@QueueLabel(queue) · @Text.Format("{0} calls", queue.Entered)</SUISelectItem> }
                </SUISelect>
            }
            <div class="windows" role="group" aria-label="@Text["Period"]">
                @foreach (var hours in QueueDistributionView.Windows)
                { <button type="button" class="@(Window == hours ? "active" : "")" aria-pressed="@(Window == hours ? "true" : "false")" @onclick="() => SetWindow(hours)">@WindowLabel(hours)</button> }
            </div>
        </div>
        @if (Search.Length > 0 || NodeFilter.Length > 0 || QueueId.Length > 0)
        { <p class="muted">@Text["Following the page filters above."]</p> }
    </div>

    @if (Error is not null) { <SUIAlert ToneValue="SUITone.Warning">@Text[Error]</SUIAlert> }
    else if (Reply is null)
    {
        <div class="kpis" aria-label="@Text["Loading queue distribution"]">
            @foreach (var (label, icon) in new[] { ("Calls received", "phone"), ("Answered", "check-circle"), ("Abandoned", "x"), ("Average wait", "clock") })
            { <SUIStat Label="@Text[label]" Icon="@icon" ColorValue="SUIColor.Secondary" Loading="true" /> }
        </div>
    }
    else if (Detail is null && Ranking.Length > 0)
    {
        var maxEntered = Math.Max(1, Ranking[0].Entered);
        <ol class="ranking" aria-label="@Text["Busiest queues"]">
            @foreach (var (item, index) in Ranking.Take(RankLimit).Select((q, i) => (q, i)))
            {
                <li @key="item.Key">
                    <button type="button" class="ranking-row" @onclick="() => SelectQueue(item.Key)" title="@Text["Open this queue's distribution"]">
                        <span class="ranking-position">@(index + 1)</span>
                        <span class="ranking-name">@QueueLabel(item)</span>
                        <span class="ranking-bar"><span class="fill" style="width:@Css(100.0 * item.Entered / maxEntered)%">
                            @if (item.Answered > 0) { <span class="seg good" style="flex-grow:@item.Answered"></span> }
                            @if (item.Abandoned > 0) { <span class="seg bad" style="flex-grow:@item.Abandoned"></span> }
                            @if (item.Other > 0) { <span class="seg neutral" style="flex-grow:@item.Other"></span> }
                        </span></span>
                        <span class="ranking-total"><b>@item.Entered</b> @Text["calls"]</span>
                        <span class="ranking-meta">@Percent(item.AnswerRate) @Text["answered"] · @Text["wait"] @Duration(item.AverageWait)</span>
                    </button>
                </li>
            }
        </ol>
        @if (Ranking.Length > RankLimit) { <SUIButton VariantValue="SUIVariant.Text" OnClick="() => RankLimit += 20">@Text["Show more"] (@(Ranking.Length - RankLimit))</SUIButton> }
        <ul class="legend" aria-label="@Text["Legend"]">
            <li><span class="dot good"></span>@Text["Answered call"]</li>
            <li><span class="dot bad"></span>@Text["Abandoned call"]</li>
            <li><span class="dot neutral"></span>@Text["Left the queue"]</li>
        </ul>
    }
    else if (Detail is null)
    {
        @if (Search.Length > 0 || NodeFilter.Length > 0)
        { <p class="monitor-empty">@Text.Format("No queue with calls matches the filters (search \"{0}\"). Search by queue number, extension or member name.", Search)</p> }
        else
        { <p class="monitor-empty">@Text["No queue calls observed in this period. Counting starts when the collector receives the PBX queue events."]</p> }
    }
    else
    {
        var queue = Detail.Queue;
        var maxRung = Math.Max(1, Detail.Members.Select(m => m.Offered).DefaultIfEmpty(0).Max());
        var active = Detail.Calls.Where(c => c.Outcome == "waiting" && c.EnteredAt > DateTimeOffset.UtcNow.AddHours(-1)).ToArray();
        var waitingNow = LiveWaiting ?? active.Length;
        <div class="kpis">
            @if (ShowWaiting)
            {
            <SUIStat Value="@waitingNow.ToString()" Unit="@(LiveCapacity is > 0 ? "/" + LiveCapacity : null)" Label="@Text["Waiting now"]" Icon="bell" Animation="SUIAnimation.Default | SUIAnimation.ValueFlash"
                     ColorValue="SUIColor.Warning" Appearance="@(waitingNow > 0 ? SUIStatAppearance.Gradient : SUIStatAppearance.Soft)"
                     Caption="@(LiveCapacity == 0 ? Text["no capacity limit"] : null)">
                @if (LiveCapacity is > 0 and var cap)
                { <span class="now-bar" role="meter" aria-valuemin="0" aria-valuemax="@cap" aria-valuenow="@waitingNow" title="@Text.Format("capacity {0}", cap)"><span class="@(waitingNow >= cap ? "full" : waitingNow * 2 >= cap ? "half" : "")" style="width:@Css(100.0 * waitingNow / cap)%"></span></span> }
            </SUIStat>
            }
            <SUIStat Value="@queue.Entered.ToString()" Label="@Text["Calls received"]" Icon="phone" ColorValue="SUIColor.Info"
                     Appearance="SUIStatAppearance.Gradient" Sparkline="@Spark(queue.EnteredByHour)" />
            <SUIStat Value="@queue.Answered.ToString()" Label="@Text["Answered"]" Icon="check-circle" ColorValue="SUIColor.Success"
                     Appearance="SUIStatAppearance.Soft" Caption="@Percent(queue.AnswerRate)" Sparkline="@Spark(queue.AnsweredByHour)" />
            <SUIStat Value="@queue.Abandoned.ToString()" Label="@Text["Abandoned"]" Icon="x" ColorValue="SUIColor.Error"
                     Appearance="SUIStatAppearance.Soft" Sparkline="@Spark(queue.AbandonedByHour)" />
            <SUIStat Value="@Duration(queue.AverageWait)" Label="@Text["Average wait"]" Icon="clock" ColorValue="SUIColor.Secondary" />
            <SUIStat Value="@Detail.Members.Count(m => m.Answered > 0).ToString()" Unit="@("/" + Detail.Members.Length)" Label="@Text["Extensions that answered"]"
                     Icon="users" ColorValue="SUIColor.Primary" Appearance="SUIStatAppearance.Image" />
        </div>
        @if (active.Length > 0)
        {
            <section class="now-calls" aria-label="@Text["Calls waiting now"]">
                @foreach (var call in active.Take(12))
                {
                    <div class="now-call" @key="call.Uniqueid">
                        <span class="now-call-who"><b>@(call.Caller.Length > 0 ? call.Caller : Text["Unknown number"])</b> · @Text["waiting"] @Duration((long)(DateTimeOffset.UtcNow - call.EnteredAt).TotalSeconds)</span>
                        <span class="attempts">
                            @foreach (var attempt in call.Attempts)
                            { <span class="attempt @OutcomeTone(attempt.Outcome) @(attempt.Outcome == "ringing" ? "ringing" : "")" title="@($"{(attempt.Name.Length > 0 ? attempt.Name : QueueDistributionView.Extension(attempt.Member))} · {Text[AttemptOutcome(attempt.Outcome)]}{(attempt.Cycles > 1 ? " · " + Text.Format("rung {0} times", attempt.Cycles) : "")}")">@Short(attempt.Member)</span> }
                            @if (call.Attempts.Length == 0) { <span class="muted">@Text["not offered to any extension yet"]</span> }
                        </span>
                    </div>
                }
            </section>
        }

        <figure class="hours" aria-label="@Text["Calls per hour"]">
            <figcaption>@Text["Calls per hour"]</figcaption>
            @{
                // Same period as the rest of the card; bars stay slim (max 30 px) even with few hours.
                var day = queue;
                var starts = QueueDistributionView.HourStarts(DateTimeOffset.Now, day.EnteredByHour.Length);
                var maxHour = Math.Max(1, day.EnteredByHour.DefaultIfEmpty(0).Max());
            }
            <div class="hour-bars">
                @for (var i = 0; i < day.EnteredByHour.Length; i++)
                {
                    var entered = day.EnteredByHour[i]; var answered = day.AnsweredByHour[i]; var abandoned = day.AbandonedByHour[i];
                    var other = Math.Max(0, entered - answered - abandoned);
                    var isNow = i == day.EnteredByHour.Length - 1;
                    var outside = false;
                    <div class="hour @(isNow ? "now" : "") @(outside ? "outside" : "") @(entered == 0 ? "empty" : "") @(entered == maxHour && entered > 0 ? "peak" : "")" style="--i:@i"
                         title="@($"{starts[i]:HH}h · {entered} {Text["received"]} · {answered} {Text["answered"]} · {abandoned} {Text["abandoned"]}")">
                        @if (entered > 0) { <span class="hour-count">@entered</span> }
                        <div class="stack" style="height:@Css(100.0 * entered / maxHour)%">
                            @if (abandoned > 0) { <span class="seg bad" style="flex-grow:@abandoned"></span> }
                            @if (other > 0) { <span class="seg neutral" style="flex-grow:@other"></span> }
                            @if (answered > 0) { <span class="seg good" style="flex-grow:@answered"></span> }
                        </div>
                        <span class="hour-label">@(isNow ? Text["now"] : day.EnteredByHour.Length <= 8 || i % 3 == (day.EnteredByHour.Length - 1) % 3 ? starts[i].ToString("HH") + "h" : "")</span>
                    </div>
                }
            </div>
        </figure>

        <section class="members" aria-labelledby="members-title">
            <h3 id="members-title">@Text["By extension"]</h3>
            <ul class="legend" aria-label="@Text["Legend"]">
                <li><span class="dot good"></span>@Text["Took the call"]</li>
                <li><span class="dot warn"></span>@Text["Rang, not answered"]</li>
                <li><span class="dot bad"></span>@Text["Unavailable"]</li>
                <li><span class="dot neutral"></span>@Text["Someone else answered or caller hung up"]</li>
            </ul>
            @if (Config is { } config)
            {
                <p class="config-line">
                    <span><span class="muted">@Text["Distribution"]</span> <b>@Text[QueueDistributionView.StrategyLabel(config.Strategy)]</b>@(config.Strategy == "groups" ? " " + Text.Format("of {0}", config.GroupSize) : "")</span>
                    <span><span class="muted">@Text["Ring per extension"]</span> <b>@Duration(config.AgentTimeoutSeconds)</b></span>
                    <span><span class="muted">@Text["Capacity"]</span> <b>@(config.MaxWaiting == 0 ? Text["no limit"] : config.MaxWaiting.ToString())</b></span>
                    @if (config.PenaltySteps is { Length: > 0 } steps)
                    { <span><span class="muted">@Text["Penalty escalation"]</span> <b>@string.Join(" → ", steps.OrderBy(p => p.AfterSeconds).Select(p => $"{p.AfterSeconds}s ≤ {p.MaxPenalty}"))</b></span> }
                    else if (config.MaxPenalty < 1000000) { <span><span class="muted">@Text["Max penalty"]</span> <b>@config.MaxPenalty</b></span> }
                </p>
            }
            @if (Detail.Members.Length == 0) { <p class="muted">@Text["No extension rang in this period."]</p> }
            @{ var ringingNow = Detail.Calls.Where(c => c.Outcome == "waiting").SelectMany(c => c.Attempts).Where(a => a.Outcome == "ringing")
                   .Select(a => QueueDistributionView.Extension(a.Member)).ToHashSet(); }
            @foreach (var (member, index) in Detail.Members.Select((m, i) => (m, i)))
            {
                var tone = member.Offered > 0 && member.Unavailable == member.Offered ? "bad" : member.AnswerRate is null ? "neutral"
                    : member.AnswerRate >= .5 ? "good" : member.AnswerRate >= .2 ? "warn" : "bad";
                var ringing = ringingNow.Contains(member.Extension);
                <div class="member @(ringing ? "ringing" : "")" @key="member.Member" style="--i:@index">
                    <span class="member-avatar @tone @(index < 3 && member.Answered > 0 ? "medal medal-" + (index + 1) : "")" aria-hidden="true">@Initials(member.Label)</span>
                    <div class="member-name"><strong>@member.Label</strong>@if (member.Label != member.Extension) { <small>@member.Extension</small> }
                        @if (ringing) { <span class="ringing-chip">@Text["ringing now"]</span> }
                        @if (ConfigMember(member.Extension) is { } configured) { <span class="member-flags">@MemberFlags(configured)</span> }</div>
                    <div class="track" role="img" aria-label="@MemberSummary(member)" title="@MemberSummary(member)">
                        <div class="fill" style="width:@Css(100.0 * member.Offered / maxRung)%">
                            @if (member.Answered > 0) { <span class="seg good" style="flex-grow:@member.Answered"></span> }
                            @if (member.Missed > 0) { <span class="seg warn" style="flex-grow:@member.Missed"></span> }
                            @if (member.Unavailable > 0) { <span class="seg bad" style="flex-grow:@member.Unavailable"></span> }
                            @if (member.Cancelled > 0) { <span class="seg neutral" style="flex-grow:@member.Cancelled"></span> }
                        </div>
                    </div>
                    <div class="member-counts">
                        @if (member.Answered > 0) { <span class="good"><i></i><b>@member.Answered</b> @Text["member answered"]</span> }
                        @if (member.Missed > 0) { <span class="warn"><i></i><b>@member.Missed</b> @Text["not answered"]</span> }
                        @if (member.Unavailable > 0) { <span class="bad"><i></i><b>@member.Unavailable</b> @Text["unavailable"]</span> }
                        @if (member.Cancelled > 0) { <span class="neutral"><i></i><b>@member.Cancelled</b> @Text["others answered"]</span> }
                    </div>
                    <div class="member-meta">
                        <span>@Text.Format("Offered {0} calls", member.Offered)</span>
                        <span>@Text["Answer rate"] <b>@Percent(member.AnswerRate)</b></span>
                        <span>@Text["Ring"] <b>@Duration(member.AverageRing)</b></span>
                        <span>@Text["Talk"] <b>@Duration(member.AverageTalk)</b></span>
                        <span>@Text["Last answer"] <b>@Ago(member.LastAnswered)</b></span>
                    </div>
                </div>
            }
            @if (Config?.Members is { } all && all.Where(m => Detail.Members.All(d => d.Extension != m.Extension)).ToArray() is { Length: > 0 } idle)
            {
                <div class="idle-members"><span class="muted">@Text["Members that did not ring in this period"]:</span>
                    @foreach (var m in idle.OrderBy(m => m.Penalty).ThenBy(m => m.Extension))
                    { <span class="attempt neutral" title="@(m.Title ?? m.Extension)">@Short(m.Extension) @MemberFlags(m)</span> }
                </div>
            }
        </section>

        <details class="calls">
            <summary>@Text["Latest calls and who rang"] (@Detail.Calls.Length)</summary>
            @foreach (var call in Detail.Calls.Take(CallLimit))
            {
                <div class="call" @key="call.Uniqueid">
                    <span class="call-time">@call.EnteredAt.ToLocalTime().ToString("HH:mm:ss")</span>
                    <span class="call-caller">@(call.Caller.Length > 0 ? call.Caller : Text["Unknown number"])</span>
                    <span class="outcome @OutcomeTone(call.Outcome)">@Text[CallOutcome(call.Outcome)]</span>
                    <span class="muted">@Text["wait"] @Duration(call.WaitSeconds)</span>
                    <span class="attempts">
                        @foreach (var attempt in call.Attempts)
                        { <span class="attempt @OutcomeTone(attempt.Outcome)" title="@($"{(attempt.Name.Length > 0 ? attempt.Name : QueueDistributionView.Extension(attempt.Member))} · {Text[AttemptOutcome(attempt.Outcome)]}{(attempt.Cycles > 1 ? " · " + Text.Format("rung {0} times", attempt.Cycles) : "")}{(attempt.RingSeconds > 0 ? " · " + Duration(attempt.RingSeconds) : "")}")">@Short(attempt.Member)</span> }
                    </span>
                </div>
            }
            @if (Detail.Calls.Length > CallLimit)
            { <SUIButton VariantValue="SUIVariant.Text" OnClick="() => CallLimit += 30">@Text["Show more"]</SUIButton> }
        </details>
    }
</section>

@code {
    [Parameter] public string Context { get; set; } = "";
    [Parameter] public bool Preview { get; set; }
    /// <summary>Page search (queue number, extension or member name) and server filter, shared with the rest of the page.</summary>
    [Parameter] public string Search { get; set; } = "";
    [Parameter] public string Node { get; set; } = "all";
    /// <summary>Queue controller id from the URL (?queueid=, e.g. the "Monitorar" link of the entry plan).</summary>
    [Parameter] public string QueueId { get; set; } = "";
    /// <summary>Live waiting count and capacity of the focused queue when the queue controller reports them (null for native queues).</summary>
    /// <summary>False when the page already shows "waiting now" for this queue (avoids a duplicate card).</summary>
    [Parameter] public bool ShowWaiting { get; set; } = true;
    [Parameter] public int? LiveWaiting { get; set; }
    [Parameter] public int? LiveCapacity { get; set; }
    /// <summary>Extensions that rang in the focused queue, so the page can filter presence to them.</summary>
    [Parameter] public EventCallback<string[]> MembersChanged { get; set; }
    private string ReportedMembers = "\0";
    private string NodeFilter => Node is "" or "all" ? "" : Node;
    private string LoadedKey = "";
    private string FilterKey => Context + "|" + NodeFilter + "|" + Search.Trim() + "|" + QueueId;
    private bool Demo => Preview && Environment.IsDevelopment();
    private DistributionReply? Reply;
    private DistributionQueue[] Queues = [];
    private DistributionDetail? Detail;
    private string SelectedKey = "", LoadedContext = "", ActiveKey = "";
    private QueueConfigurationItem? Config;
    private QueueConfigurationMember? ConfigMember(string extension) => Config?.Members?.FirstOrDefault(m => m.Extension == extension);
    private string MemberFlags(QueueConfigurationMember m) => string.Join(" · ", new[]
    {
        Text.Format("penalty {0}", m.Penalty),
        m.Paused ? Text["paused"] : null, !m.Enabled ? Text["disabled"] : null, m.Dynamic && !m.LoggedIn ? Text["logged out"] : null
    }.OfType<string>());
    private DistributionQueue[] Ranking = [];
    private int RankLimit = 20;
    private int Window = 24, CallLimit = 30;
    private string? Error;
    private bool Busy, Disposed;
    private readonly CancellationTokenSource Lifetime = new();
    private Task? Loop;

    protected override async Task OnInitializedAsync()
    {
        ReadUrl(); Navigation.LocationChanged += LocationChanged;
        await Refresh(); Loop = Poll();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (LoadedKey == FilterKey || Reply is null && LoadedKey.Length == 0) return;
        Detail = null; Reply = null;
        await Refresh();
    }
    /// <summary>Queue and period live in the URL (dqueue, dperiod) like the page filters.</summary>
    private void ReadUrl()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        SelectedKey = query.TryGetValue("dqueue", out var queue) && queue.Count == 1 && queue[0] is { Length: > 2 and <= 260 } key && key.Contains('|') ? key : "";
        Window = query.TryGetValue("dperiod", out var period) && int.TryParse(period, out var hours) && QueueDistributionView.Windows.Contains(hours) ? hours : 24;
    }
    // A queue chosen here becomes the page's queue filter; going back to the ranking clears both forms of it.
    private void WriteUrl(bool queueChanged = false)
    {
        var values = new Dictionary<string, object?> { ["dqueue"] = SelectedKey.Length == 0 ? null : SelectedKey, ["dperiod"] = Window == 24 ? null : Window };
        if (queueChanged) values["queueid"] = null;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(values), replace: true);
    }
    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var (key, window) = (SelectedKey, Window);
        ReadUrl();
        if (key != SelectedKey || window != Window) _ = InvokeAsync(async () => { CallLimit = 30; await Refresh(); });
    }
    private Task SelectQueue(string key) { SelectedKey = key; CallLimit = 30; WriteUrl(queueChanged: true); return Refresh(); }
    private void SetWindow(int hours) { Window = hours; Rebuild(); WriteUrl(); }

    private bool Pending;
    private async Task Refresh()
    {
        if (Disposed) return;
        // A selection made while a poll is in flight must not be dropped: run again right after it.
        if (Busy) { Pending = true; return; }
        Busy = true; Pending = false;
        try
        {
            var context = Guid.TryParse(Context, out var id) ? id : (Guid?)null;
            var requested = Context;
            if (Demo) Reply = QueueDistributionView.Filter(QueueDistributionFixture.Create(DateTimeOffset.UtcNow), NodeFilter, Search.Trim());
            else if (!Access.Enabled) { Error = "Queue distribution is not configured on this server."; return; }
            else
            {
                // The summary lists the queues; the detail brings members and calls of the selected one only.
                var summary = await Access.Read(context, NodeFilter, "", true, Lifetime.Token, Search.Trim());
                // Without a chosen queue the card shows the ranking (summary only); a queue opens its detail.
                var candidates = QueueDistributionView.Queues(summary, 24);
                var top = SelectedKey.Length > 0 && summary.Queues.Any(q => q.Node + "|" + q.Queue == SelectedKey) ? SelectedKey
                    : QueueId.Length > 0 ? candidates.FirstOrDefault(q => q.Queue == QueueId)?.Key ?? ""
                    : Search.Trim().Length > 0 && candidates.Length == 1 ? candidates[0].Key : "";
                var detail = top.Length == 0 ? new DistributionReply()
                    : await Access.Read(context, top.Split('|')[0], top[(top.IndexOf('|') + 1)..], false, Lifetime.Token);
                detail.Queues.Clear(); detail.Queues.AddRange(summary.Queues);
                detail.StartedAtMs = summary.StartedAtMs; detail.NowMs = summary.NowMs;
                Reply = detail; ActiveKey = top;
                // Strategy and penalties exist only for Queue controller queues (queue id is a GUID).
                Config = null;
                if (top.Split('|', 2) is [var node, var queue] && Guid.TryParseExact(queue, "N", out _)
                    && summary.Queues.FirstOrDefault(q => q.Node == node && q.Queue == queue) is { } stat && Guid.TryParse(stat.Account, out var owner))
                    Config = await Access.Configuration(owner, node, queue, Lifetime.Token);
            }
            LoadedContext = requested; LoadedKey = FilterKey;
            Error = null;
            Rebuild();
        }
        catch (UnauthorizedAccessException) { Error = "Your access expired. Sign in again."; }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
        catch (InvalidOperationException e) { Error = e.Message; }
        finally
        {
            Busy = false;
            if (!Disposed) StateHasChanged();
            if (Pending && !Disposed) _ = InvokeAsync(Refresh);
        }
    }

    private void Rebuild()
    {
        if (Reply is null) return;
        Queues = QueueDistributionView.Queues(Reply, 24);
        if (QueueId.Length > 0) Queues = Queues.Where(q => q.Queue == QueueId).ToArray();
        Ranking = QueueDistributionView.Queues(Reply, Window).Where(q => q.Entered > 0).ToArray();
        if (Demo) ActiveKey = SelectedKey.Length > 0 && Queues.Any(q => q.Key == SelectedKey) ? SelectedKey
            : QueueId.Length > 0 ? Queues.FirstOrDefault()?.Key ?? "" : Search.Trim().Length > 0 && Queues.Length == 1 ? Queues[0].Key : "";
        var parts = ActiveKey.Split('|', 2);
        Detail = parts.Length == 2 ? QueueDistributionView.Detail(Reply, parts[0], parts[1], Window) : null;
        var members = Detail is null ? [] : Detail.Members.Select(m => m.Extension)
            .Concat(Detail.Calls.SelectMany(c => c.Attempts).Select(a => QueueDistributionView.Extension(a.Member))).Distinct().Order().ToArray();
        if (string.Join(",", members) is var joined && joined != ReportedMembers && MembersChanged.HasDelegate)
        { ReportedMembers = joined; _ = InvokeAsync(() => MembersChanged.InvokeAsync(members)); }
        CommonPrefix = Detail is null ? 0 : Prefix(Detail.Calls.SelectMany(c => c.Attempts).Select(a => QueueDistributionView.Extension(a.Member))
            .Concat(Detail.Members.Select(m => m.Extension)).Distinct().ToArray());
    }

    private async Task Poll()
    {
        // A focused queue shows calls ringing now: refresh every 3 s; the ranking every 10 s.
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var tick = 0;
        try { while (await timer.WaitForNextTickAsync(Lifetime.Token)) if (++tick % (ActiveKey.Length > 0 ? 3 : 10) == 0) await InvokeAsync(Refresh); }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
    }

    /// <summary>Members of one company usually share a long numbering prefix (0007366001…); chips show only what differs.</summary>
    private string Short(string member)
    {
        var extension = QueueDistributionView.Extension(member);
        // Keep at least four digits so "6004" stays recognisable instead of a lone "4".
        var cut = Math.Min(CommonPrefix, extension.Length - 4);
        return cut > 0 ? extension[cut..] : extension;
    }
    private int CommonPrefix;
    private static int Prefix(string[] values)
    {
        if (values.Length < 2) return 0;
        var length = values.Min(v => v.Length) - 1;
        for (var i = 0; i < length; i++) if (values.Any(v => v[i] != values[0][i])) return i;
        return Math.Max(0, length);
    }
    private string Started => Reply is null ? "" : DateTimeOffset.FromUnixTimeMilliseconds(Reply.StartedAtMs).ToLocalTime().ToString("g", Text.Culture);
    private string QueueLabel(DistributionQueue queue) => queue.Label + (Queues.Select(q => q.Node).Distinct().Count() > 1 ? " · " + queue.Node : "");
    private string WindowLabel(int hours) => hours == 1 ? Text["This hour"] : Text.Format("Last {0} h", hours);
    /// <summary>Hourly series for a stat sparkline; hidden for one-bucket windows.</summary>
    private static IReadOnlyList<double>? Spark(long[] hours) => hours.Length >= 2 && hours.Any(h => h > 0) ? hours.Select(h => (double)h).ToArray() : null;
    /// <summary>Two letters for the member avatar: first letters of the first two words, digits otherwise.</summary>
    private static string Initials(string label)
    {
        var words = label.Split([' ', '-', '_'], StringSplitOptions.RemoveEmptyEntries).Where(w => char.IsLetter(w[0])).ToArray();
        return words.Length >= 2 ? $"{char.ToUpperInvariant(words[0][0])}{char.ToUpperInvariant(words[1][0])}"
            : words.Length == 1 ? words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant() : label[^Math.Min(2, label.Length)..];
    }
    private static string Css(double value) => Math.Clamp(value, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string Percent(double? value) => value is { } v ? $"{v * 100:0}%" : "—";
    private static string Duration(long? seconds) => seconds switch { null => "—", < 60 => $"{seconds} s", _ => $"{seconds / 60} min {seconds % 60:00} s" };
    private string Ago(DateTimeOffset? at)
    {
        if (at is not { } time) return Text["never"];
        var elapsed = DateTimeOffset.UtcNow - time;
        return elapsed.TotalMinutes < 1 ? Text["just now"] : elapsed.TotalHours < 1 ? Text.Format("{0} min ago", (int)elapsed.TotalMinutes)
            : time.ToLocalTime().ToString("HH:mm");
    }
    private string MemberSummary(DistributionMember m) => Text.Format("{0}: rang {1}, answered {2}, not answered {3}, unavailable {4}, others answered {5}",
        m.Label, m.Offered, m.Answered, m.Missed, m.Unavailable, m.Cancelled);
    private static string OutcomeTone(string outcome) => outcome switch
    { "answered" => "good", "no-answer" => "warn", "abandoned" or "unavailable" => "bad", _ => "neutral" };
    private static string CallOutcome(string outcome) => outcome switch
    { "answered" => "Answered call", "abandoned" => "Abandoned call", "left" => "Left the queue", _ => "Still in queue" };
    private static string AttemptOutcome(string outcome) => outcome switch
    {
        "answered" => "Took the call", "no-answer" => "Rang, not answered", "unavailable" => "Unavailable",
        "other-answered" => "Someone else answered", "caller-hangup" => "Caller hung up", "cancelled" => "Call left the queue", _ => "Ringing"
    };
    public async ValueTask DisposeAsync() { Disposed = true; Navigation.LocationChanged -= LocationChanged; Lifetime.Cancel(); if (Loop is not null) await Loop; Lifetime.Dispose(); }
}
