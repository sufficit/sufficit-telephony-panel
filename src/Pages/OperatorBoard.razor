@using Sufficit.Telephony.Panel.Operations
@using Sufficit.Telephony.EventsPanel
<section class="operator-board" aria-label="@Text["Operation board"]">
    @if (!Compact)
    {
    <div class="board-legend" aria-label="@Text["Observed state legend"]">
        <span class="legend-online">@Text["Reachable / registered"]</span><span class="legend-busy">@Text["With channels / in use"]</span><span class="legend-ringing">@Text["Ringing"]</span><span class="legend-offline">@Text["No response / unregistered"]</span><span>@Text["No information"]</span>
    </div>
    }
    <div class="board-columns">
        <section class="board-section" aria-labelledby="board-extensions">
            <header class="board-section-heading"><h3 id="board-extensions">@(Central ? Text["Extensions and endpoints"] : Text["Extensions"])</h3><div class="board-heading-tools"><span>@Peers.Length</span>@HeaderTools</div></header>
            <div class="board-grid">
                @foreach (var tile in Peers.Skip(page * Size).Take(Size)) { @TileButton(tile) }
            </div>
            @if (Peers.Length == 0) { <p class="board-empty">@Text["No extension or endpoint matches the filters."]</p> }
            @if (Peers.Length > Size) { <div class="board-paging"><SUIButton VariantValue="SUIVariant.Text" Disabled="@(page == 0)" OnClick="() => PageChanged.InvokeAsync(page - 1)">@Text["Previous"]</SUIButton><span>@(page + 1) / @Pages</span><SUIButton VariantValue="SUIVariant.Text" Disabled="@(page + 1 >= Pages)" OnClick="() => PageChanged.InvokeAsync(page + 1)">@Text["Next"]</SUIButton></div> }
        </section>
        <aside class="board-sidebar">
            <section class="board-section" aria-labelledby="board-trunks">
                <header class="board-section-heading"><h3 id="board-trunks">@Text["Trunks"]</h3><span>@Trunks.Length</span></header>
                <div class="board-trunks">@foreach (var tile in Trunks.Take(40)) { @TileButton(tile) }</div>
                @if (Trunks.Length == 0) { <p class="board-empty">@Text["No trunk matches the filters. Use Configure board to classify and group trunk identifiers."]</p> }
                @if (Trunks.Length > 40) { <p class="board-empty">@Text.Format("Showing 40 of {0} trunks. Refine the filters.", Trunks.Length)</p> }
            </section>
            <section class="board-section" aria-labelledby="board-queues">
                <header class="board-section-heading"><h3 id="board-queues">@Text["Call queues"]</h3><span>@Queues.Length</span></header>
                <div class="board-queues">@foreach (var tile in Queues.Take(40)) { @TileButton(tile) }</div>
                @if (Queues.Length == 0) { <p class="board-empty">@Text["No queues observed or remembered with these filters."]</p> }
                @if (Queues.Length > 40) { <p class="board-empty">@Text.Format("Showing 40 of {0} queues. Refine the filters.", Queues.Length)</p> }
            </section>
        </aside>
    </div>
</section>
@if (MenuTile is { } menu)
{
    <BoardCardMenu @key="menu.Id" Tile="menu" X="MenuX" Y="MenuY" Closed="() => MenuTile = null" Selected="Select" Action="Supervise" />
}
@code {
    [Parameter] public EventCallback<BoardSupervisionAction> Supervise { get; set; }
    private OperatorTile? MenuTile;
    private double MenuX, MenuY;
    private void OpenMenu(OperatorTile tile, MouseEventArgs e) { MenuTile = tile; MenuX = e.ClientX; MenuY = e.ClientY; }
    private void MenuKey(OperatorTile tile, KeyboardEventArgs e)
    { if (e.Key == "ContextMenu" || (e.ShiftKey && e.Key == "F10")) { MenuTile = tile; MenuX = MenuY = 0; } }
    [CascadingParameter(Name = "PanelLanguage")] public string Language { get; set; } = "en";
    [Parameter] public OperatorTile[] Tiles { get; set; } = [];
    [Parameter] public bool Central { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public RenderFragment? HeaderTools { get; set; }
    [Parameter] public string? Selected { get; set; }
    [Parameter] public EventCallback<OperatorTile> Select { get; set; }
    [Parameter] public int Page { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    private const int Size = 120;
    private int page => Math.Clamp(Page, 0, Pages - 1);
    private OperatorTile[] Peers => Tiles.Where(t => t.Kind == EventsPanelCardKind.PEER).ToArray();
    private OperatorTile[] Trunks => Tiles.Where(t => t.Kind == EventsPanelCardKind.TRUNK).ToArray();
    private OperatorTile[] Queues => Tiles.Where(t => t.Kind == EventsPanelCardKind.QUEUE).ToArray();
    private int Pages => Math.Max(1, (Peers.Length + Size - 1) / Size);
    private string FlowStatus(OperatorTile tile)
    {
        if (tile.Acd is { } acd)
            return acd.State != "current" ? Text["ACD state unavailable"]
                : Text.Format("{0} pending · {1} in service", acd.Details["pending"], acd.Details["connected"]);
        if (tile.Kind == EventsPanelCardKind.QUEUE && tile.QueueCalls.Length > 0)
            return Text.Format("{0} waiting · {1} answered", tile.QueueCalls.Count(r => r.State != "answered"), tile.QueueCalls.Count(r => r.State == "answered"));
        if (tile.Flows.Length == 0) return Text.Observed(tile.Status.Label);
        var correlated = tile.Flows.Count(f => f.Correlated);
        var label = correlated == tile.Flows.Length ? Text.Format("{0} observed calls", correlated)
            : correlated == 0 ? Text.Format("{0} uncorrelated channels", tile.Flows.Length)
            : Text.Format("{0} correlated calls · {1} uncorrelated channels", correlated, tile.Flows.Length - correlated);
        return tile.Status.Tone == "ringing" ? Text["Ringing"] + " · " + label : label;
    }
    private RenderFragment TileButton(OperatorTile tile) => @<div class="board-card" @oncontextmenu="e => OpenMenu(tile, e)" @oncontextmenu:preventDefault="true" @onkeydown="e => MenuKey(tile, e)">
    <button type="button"
        class="board-tile tone-@tile.Status.Tone @(Selected == tile.Id ? "is-selected" : "")"
        aria-pressed="@(Selected == tile.Id)" @onclick="() => Select.InvokeAsync(tile)"
        title="@Text.Format("{0} · {1} · {2}. Open details.", tile.Title, tile.Node, Text.Observed(tile.Status.Label))">
        <span class="tile-title"><span class="tile-dot" aria-hidden="true"></span><strong>@tile.Title</strong></span>
        <span class="tile-status">@FlowStatus(tile)</span><span class="tile-node">@tile.Node</span>
        @foreach (var flow in tile.Flows.Take(2)) { <span class="tile-channel">@(LiveProjection.Meaningful(flow.Caller) ? flow.Caller : Text["Source not reported"]) → @(LiveProjection.Meaningful(flow.Destination) ? flow.Destination : Text["Destination not reported"])@if (tile.Acd is not null) { <text> · @Text[flow.Phase switch { "greeting" => "Queue greeting", "announcing" => "Queue announcement", "offering" => "Calling an agent", "answered" => "Answered in queue", _ => "Waiting in queue" }]</text> }</span> }
        @if (tile.Flows.Length > 2) { <span class="tile-channel">@Text.Format("+{0} call flows in details", tile.Flows.Length - 2)</span> }
    </button>
    <SUIButton Class="card-menu-trigger" SizeValue="SUISize.Small" VariantValue="SUIVariant.Text" StartIcon="@SUIIcons.Menu"
        aria-haspopup="menu" aria-label="@Text.Format("Actions for {0}", tile.Title)" title="@Text["Card actions"]" OnClick="e => OpenMenu(tile, e)" />
    </div>;
}
