{
  "schemaVersion": 1,
  "manifestId": "sufficit-telephony-panel-eveo",
  "rolloutMode": "Enforce",
  "scopes": [{
    "name": "entitlements",
    "displayName": "Diretivas de acesso do usuário",
    "description": "Contêm as autorizações individuais de ações internas do sistema. Sucessor de directives (aceito pelo Identity desde 1c97032).",
    "resources": [
      "SufficitEndpointsIntrospection",
      "https://endpoints.sufficit.com.br/mcp",
      "sufficit-cloud-mobile-api"
    ]
  }],
  "clients": [{
    "clientId": "sufficit-telephony-panel",
    "displayName": "Sufficit Telephony Panel",
    "clientType": "public",
    "consentType": "explicit",
    "requirePkce": true,
    "grantTypes": ["authorization_code"],
    "responseTypes": ["code"],
    "scopes": ["openid", "profile", "roles", "entitlements"],
    "redirectUris": [
      "https://panel.sufficit.com.br/telephony-panel/signin-oidc",
      "https://eveo-apps.sufficit.com.br/telephony-panel/signin-oidc"
    ]
  }]
}
